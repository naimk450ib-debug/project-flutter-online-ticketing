{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Flutter: Run App",
      "type": "shell",
      "command": "flutter",
      "args": ["run"],
      "group": {
        "kind": "test",
        "isDefault": false
      },
      "problemMatcher": ["$dart-flutter"]
    },
    {
      "label": "Flutter: Run Tests",
      "type": "shell",
      "command": "flutter",
      "args": ["test"],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": ["$dart-flutter"]
    },
    {
      "label": "Flutter: Analyze Code",
      "type": "shell",
      "command": "dart",
      "args": ["analyze", "lib"],
      "group": "build",
      "problemMatcher": ["$dart-analyze"]
    },
    {
      "label": "Flutter: Hot Reload",
      "type": "shell",
      "command": "flutter",
      "args": ["run", "-d", "windows"],
      "group": "build",
      "problemMatcher": ["$dart-flutter"]
    }
  ]
}
